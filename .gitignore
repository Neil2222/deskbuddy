# --- Hardware data that must never enter Git ---
# Flash dumps (the factory backup is ~16 MB and device-specific; see HANDOVER.md)
backup/
*.bin
*.elf
*.map

# --- Vendor reference checkout (re-clone, see README) ---
_ref/

# --- ESP-IDF build outputs (sdkconfig is regenerated from sdkconfig.defaults) ---
build/
managed_components/
sdkconfig
sdkconfig.old

# --- Desktop simulator build (tools/simulator.ps1) ---
build-sim/

# --- .NET build outputs (companion/) ---
bin/
obj/
companion/publish/

# --- Credentials and secrets ---
.env
.env.*
*.pem
*.key
*.p12
*.pfx
secrets.*
credentials*
*_secrets.h
wifi_credentials*
sdkconfig.local

# --- Editors / OS / temp ---
.vscode/
.idea/
*.swp
*~
*.tmp
*.log
Thumbs.db
desktop.ini
.DS_Store

# --- Firmware packages (tools/package-firmware.ps1) ---
dist/

# --- Bundled esptool and its sources (tools/fetch-esptool.ps1) ---
companion/third_party/esptool/esptool.exe
companion/third_party/esptool/*.tar.gz

# Public firmware signing keys are committed (never private ones: the build refuses them)
!companion/DeskBuddy.Companion/Firmware/TrustedKeys/*.pub.pem
