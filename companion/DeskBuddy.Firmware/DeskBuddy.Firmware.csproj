<Project Sdk="Microsoft.NET.Sdk">

  <!-- The firmware package format (docs/firmware-packages.md): versions, the ESP image and partition table checks, the
       signed manifest, and reading and writing packages. No UI and no serial port: the Companion, the packaging tool
       (DeskBuddy.FirmwareTool) and the tests share it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
