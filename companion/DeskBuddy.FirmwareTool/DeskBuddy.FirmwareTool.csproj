<Project Sdk="Microsoft.NET.Sdk">

  <!-- Makes, signs and checks firmware packages (docs/firmware-packages.md). A developer tool: run through
       tools/package-firmware.ps1, never shipped with the Companion. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>deskbuddy-firmware-tool</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeskBuddy.Firmware\DeskBuddy.Firmware.csproj" />
  </ItemGroup>

</Project>
