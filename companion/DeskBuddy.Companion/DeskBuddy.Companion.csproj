<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyTitle>DeskBuddy Companion</AssemblyTitle>
    <!-- Semantic version; the SDK appends the Git commit (+sha) to the product version. Firmware packages name the
         oldest Companion that can install them (minCompanion, docs/firmware-packages.md). -->
    <Version>1.1.0</Version>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>..\..\assets\buddy\buddy.ico</ApplicationIcon>
    <!-- The UI is built in code, not in the WinForms designer: designer serialization does not apply. -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="10.0.0" />
    <ProjectReference Include="..\DeskBuddy.Firmware\DeskBuddy.Firmware.csproj" />
  </ItemGroup>

  <!-- Buddy's own pixels, exported from the firmware sprites by tools/host-test.ps1 -Icons. Every face-*.png and
       myday-*.png is taken (not the @8x previews), so art exported for a new mood or activity is embedded without
       listing it here. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\buddy\face-*.png;..\..\assets\buddy\myday-*.png;..\..\assets\buddy\can.png;..\..\assets\buddy\glass.png;..\..\assets\buddy\moon.png;..\..\assets\buddy\buddy.ico"
                      Exclude="..\..\assets\buddy\*@*.png"
                      LogicalName="DeskBuddy.Assets.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- PDC Manager's own (self-signed) certificate, pinned by Pdc/PdcCertificate.cs. -->
  <ItemGroup>
    <EmbeddedResource Include="Pdc\PDCManager.cer" LogicalName="DeskBuddy.Pdc.PDCManager.cer" />
  </ItemGroup>

  <!-- The Firmware Manager's flashing tool: esptool v4.12.0, fetched and checked by tools/fetch-esptool.ps1 (not in
       Git; licence and sources in companion/third_party/esptool). Without it the Companion builds, and the Firmware
       Manager says the tool is missing. -->
  <ItemGroup Condition="Exists('..\third_party\esptool\esptool.exe')">
    <EmbeddedResource Include="..\third_party\esptool\esptool.exe" LogicalName="DeskBuddy.Tools.esptool.exe" />
  </ItemGroup>

  <!-- Public keys firmware packages may be signed with (Firmware/TrustedKeys/README.md). A private key there fails the build. -->
  <ItemGroup>
    <TrustedFirmwareKey Include="Firmware\TrustedKeys\*.pem" />
    <EmbeddedResource Include="@(TrustedFirmwareKey)" LogicalName="DeskBuddy.Firmware.TrustedKeys.%(Filename)%(Extension)" />
  </ItemGroup>
  <Target Name="RefusePrivateFirmwareKeys" BeforeTargets="BeforeBuild" Condition="'@(TrustedFirmwareKey)' != ''">
    <Error Condition="'%(TrustedFirmwareKey.FullPath)' != '' And $([System.IO.File]::ReadAllText('%(TrustedFirmwareKey.FullPath)').Contains('PRIVATE KEY'))"
           Text="%(TrustedFirmwareKey.Identity) is a private key: only public keys may be built into the Companion." />
  </Target>

</Project>
