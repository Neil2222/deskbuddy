CONFIG_IDF_TARGET="esp32s3"

# Flash: 16 MB quad, conservative 80 MHz
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# PSRAM: 8 MB octal, stable 80 MHz (120 MHz is an experimental IDF feature; evaluate later)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# Code/rodata executed from PSRAM so the RGB bounce-buffer ISR keeps running during flash ops
CONFIG_SPIRAM_XIP_FROM_PSRAM=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000

# RGB LCD: re-sync DMA at VSYNC to recover from underruns (prevents permanent image drift)
CONFIG_LCD_RGB_RESTART_IN_VSYNC=y

# Console on UART0 (CH343 port) mirrored to native USB-Serial/JTAG
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y

# The same source gives the same binaries (no build date/time, no local paths): a firmware package can be rebuilt
# and compared (docs/firmware-packages.md)
CONFIG_APP_REPRODUCIBLE_BUILD=y
